<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="yaskawa_gp7">
  <!-- GP7 meshes/geometry: yaskawa_gp7_support, Apache-2.0.
       Gripper and Gazebo-control configuration: EN3563 project work. -->
  <xacro:arg name="controllers_file" default=""/>
  <!-- Enable the initially-detached project grasp plugin for full task runs.
       The task validates alignment before requesting a fixed-joint grasp. -->
  <xacro:arg name="enable_attachment" default="false"/>
  <xacro:include filename="$(find yaskawa_gp7_support)/urdf/gp7_macro.xacro"/>
  <!-- Simulation torque budgets for the approximate masses above. The
       upstream 1 Nm placeholders cannot support this arm under gravity. -->
  <xacro:yaskawa_gp7 prefix="" effort_s="300" effort_l="300" effort_u="300" effort_r="100" effort_b="100" effort_t="50"/>

  <link name="world"/>
  <joint name="world_to_base" type="fixed"><parent link="world"/><child link="base_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <link name="tool0">
    <visual><geometry><mesh filename="file://$(find gp7_description)/meshes/gripper/flange_mount.stl"/></geometry><material name="mount_silver"><color rgba="0.35 0.38 0.42 1"/></material></visual>
    <visual><geometry><mesh filename="file://$(find gp7_description)/meshes/gripper/body.stl"/></geometry><material name="gripper_silver"><color rgba="0.70 0.73 0.77 1"/></material></visual>
    <collision><origin xyz="0 0 0.004"/><geometry><cylinder radius="0.03" length="0.008"/></geometry></collision>
    <collision><origin xyz="0 0 0.0365"/><geometry><box size="0.070 0.100 0.057"/></geometry></collision>
    <inertial><origin xyz="0 0 0.0365"/><mass value="0.3"/><inertia ixx="0.000332" ixy="0" ixz="0" iyy="0.000204" iyz="0" izz="0.000373"/></inertial>
  </link>
  <xacro:macro name="gripper_jaw" params="name">
    <link name="${name}">
      <visual><geometry><mesh filename="file://$(find gp7_description)/meshes/gripper/jaw.stl"/></geometry><material name="jaw_dark"><color rgba="0.12 0.14 0.17 1"/></material></visual>
      <collision><origin xyz="0 0 0.0325"/><geometry><box size="0.036 0.015 0.065"/></geometry></collision>
      <inertial><origin xyz="0 0 0.0325"/><mass value="0.08"/><inertia ixx="0.0000297" ixy="0" ixz="0" iyy="0.0000368" iyz="0" izz="0.0000101"/></inertial>
    </link>
  </xacro:macro>
  <xacro:gripper_jaw name="left_finger"/>
  <xacro:gripper_jaw name="right_finger"/>
  <joint name="tool_fixed_joint" type="fixed"><parent link="flange"/><child link="tool0"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <!-- The project grasp plugin needs tool0 to survive fixed-link lumping. -->
  <gazebo reference="tool_fixed_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <joint name="left_finger_joint" type="prismatic"><parent link="tool0"/><child link="left_finger"/><origin xyz="0 0.0475 0.065"/><axis xyz="0 -1 0"/><limit lower="0" upper="0.025" effort="20" velocity="0.05"/></joint>
  <joint name="right_finger_joint" type="prismatic"><parent link="tool0"/><child link="right_finger"/><origin xyz="0 -0.0475 0.065"/><axis xyz="0 1 0"/><limit lower="0" upper="0.025" effort="20" velocity="0.05"/></joint>
  <!-- Cube centre at grasp: 80 mm opening minus twice the jaw displacement.
       q=15 mm per jaw gives 50 mm clear width. TCP lies between the pads. -->
  <link name="grasp_tcp"/>
  <joint name="grasp_tcp_joint" type="fixed"><parent link="tool0"/><child link="grasp_tcp"/><origin xyz="0 0 0.1075"/></joint>

  <ros2_control name="GP7GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="joint_s"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_l"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_u"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_r"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_b"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_t"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="left_finger_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="right_finger_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
  <gazebo>
    <!--
      Gazebo Sim implements a position interface by generating a velocity
      command from the position error. Use 0.5 at 100 Hz for responsive
      tracking. Holding joints and sufficient motor effort are both needed
      to support the arm under gravity.
    -->
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <hold_joints>true</hold_joints>
      <position_proportional_gain>0.5</position_proportional_gain>
    </plugin>
    <xacro:if value="$(arg enable_attachment)">
    <plugin filename="gp7_grasp-system" name="gp7_grasp::ValidatedGrasp">
    </plugin>
    </xacro:if>
  </gazebo>
</robot>
